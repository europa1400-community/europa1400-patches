# Local paths for development (copy to .env, which is never committed). scripts/setup.ps1 creates it.

# The game directory (folder with the .exe and game.ini). Needed for install-dev, replays and build tables.
GAME_DIR=
# Executable started by the "Run game" task (e.g. GildeGold_TL.exe, Europa1400Gold_TL.exe)
GAME_EXE=GildeGold_TL.exe
# Optional: the private decompilation repository (symbols for build tables, recordings for replays). Community only.
DECOMP_DIR=
